{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "ignoreDeprecations": "6.0",
    "outDir": "./dist-electron",
    "rootDir": ".",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node", "electron"]
  },
  "include": [
    "electron/**/*.cts",
    "electron/screenplayPdf.ts",
    "electron/recents.ts",
    "electron/documents.ts",
    "src/projectMigrate.ts",
    "src/types.ts",
    "src/desktopTypes.ts"
  ]
}
